{
  "name": "@lutzseverino/site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ui:add": "node scripts/registry.mjs add",
    "ui:update": "node scripts/registry.mjs update",
    "ui:check": "node scripts/registry.mjs check",
    "i18n:source": "node scripts/translation-source.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "validate": "pnpm ui:check && pnpm check && pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/react": "7.1.2",
    "@base-ui/react": "1.9.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.0",
    "messageformat": "4.1.0",
    "micromark-extension-gfm": "3.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "oxlint": "1.86.0",
    "parse5": "8.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.1",
    "shadcn": "4.23.0",
    "typescript": "6.0.3"
  }
}
