---
// A project's facts: its stack, the year it began, its latest release and
// its last update. Each names what it is in `data-fact`, which the display's
// projects layout reads (`src/receiver/channels/projects.ts`).
import type { Project } from "@/data/projects";
import { format } from "@/i18n/format";
import type { Locale } from "@/i18n/locales";

type Props = { locale: Locale; project: Project };

const { locale, project } = Astro.props;
---

<dl class="facts">
  {project.stack.length > 0 && (
    <div data-fact="stack">
      <dt>{format(locale, "projects.stack")}</dt>
      <dd lang="en">{project.stack.join(" · ")}</dd>
    </div>
  )}
  <div data-fact="since">
    <dt>{format(locale, "projects.since")}</dt>
    <dd>{project.since}</dd>
  </div>
  <div data-fact="release">
    <dt>{format(locale, "projects.release")}</dt>
    <dd>
      {project.release ? (
        <>
          {project.release.tag} ·{" "}
          <time datetime={project.release.date}>{project.release.date}</time>
        </>
      ) : (
        format(locale, "projects.release.none")
      )}
    </dd>
  </div>
  <div data-fact="updated">
    <dt>{format(locale, "projects.updated")}</dt>
    <dd>
      <time datetime={project.updated}>{project.updated}</time>
    </dd>
  </div>
</dl>
