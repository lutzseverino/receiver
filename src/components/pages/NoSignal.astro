---
// NO SIGNAL: what the receiver shows for an address that matches no page.
// GitHub Pages serves `/404.html` for every such address; each language has
// its own at `/<locale>/404.html` (`astro.config.mjs`), and the language
// links lead to them. The language a link chooses is saved, but the page
// never sends a visit on to another language, since that page would be
// missing too.
import { format } from "@/i18n/format";
import { localePath, type Locale } from "@/i18n/locales";
import Base from "@/layouts/Base.astro";

type Props = { locale: Locale };

const { locale } = Astro.props;
---

<Base
  locale={locale}
  title={format(locale, "copy.signal.title")}
  description={format(locale, "copy.signal.description")}
  noindex
  redirect={false}
  path="/404.html"
>
  <h1>{format(locale, "signal.heading")}</h1>
  <p>{format(locale, "signal.body")}</p>
  <p>
    <a href={localePath(locale, "/")}>{format(locale, "signal.back")}</a>
  </p>
</Base>
