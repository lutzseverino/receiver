---
// A post in one of the languages it exists in: its title, date, reading time
// and body.
import { loadPosts, type Post } from "@/data/posts";
import { format } from "@/i18n/format";
import { localeRoutes, type Locale } from "@/i18n/locales";
import Base from "@/layouts/Base.astro";
import { readingTime, wireDate } from "@/lib/wire";

export async function getStaticPaths() {
  const posts = await loadPosts();
  return localeRoutes().flatMap(({ params, props }) =>
    posts
      .filter((post) => post.locale === props.locale)
      .map((post) => ({
        params: { ...params, slug: post.slug },
        props: { ...props, post },
      })),
  );
}

type Props = { locale: Locale; post: Post };

const { locale, post } = Astro.props;
---

<Base
  post={post}
  locale={locale}
  title={format(locale, "copy.post.title", { title: post.title })}
  description={format(locale, "copy.post.description", {
    summary: post.summary,
  })}
  locales={post.locales}
>
  <article>
    <h1>{post.title}</h1>
    <p class="meta">
      <time datetime={post.date}>
        {wireDate(locale, post.date, { withYear: true })}
      </time>
      <span class="reading-time">{readingTime(locale, post.minutes)}</span>
    </p>
    <Fragment set:html={post.body} />
  </article>
</Base>
