---
// The wire: every post, newest first, grouped under its year, with its date,
// or NO TRAFFIC. On the `es` and `ca` wires, a post without a translation is
// listed in English, marked EN, and links to the English page.
import { loadPosts, wirePosts } from "@/data/posts";
import { format } from "@/i18n/format";
import {
  DEFAULT_LOCALE,
  LOCALE_NAMES,
  PSEUDO_LOCALE,
  localePath,
  localeRoutes,
  type Locale,
} from "@/i18n/locales";
import Base from "@/layouts/Base.astro";
import { channel } from "@/lib/channels";
import { byYear, wireDate } from "@/lib/wire";

export function getStaticPaths() {
  return localeRoutes();
}

type Props = { locale: Locale };

const { locale } = Astro.props;
// the pseudo-locale lists what English lists
const siteLocale = locale === PSEUDO_LOCALE ? DEFAULT_LOCALE : locale;
const posts = wirePosts(await loadPosts(), siteLocale);
---

<Base
  locale={locale}
  title={format(locale, "copy.wire.title")}
  description={format(locale, "copy.wire.description")}
>
  <h1>{format(locale, "common.channel.wire")}</h1>
  {posts.length === 0 ? (
    <p class="empty">{format(locale, "wire.empty")}</p>
  ) : (
    byYear(posts).map(([year, listed]) => (
      <section class="year">
        <h2>{year}</h2>
        <ul class="entries">
          {listed.map((post) => {
            const foreign = post.locale !== siteLocale;
            return (
              <li lang={foreign ? post.locale : undefined}>
                <a
                  href={localePath(
                    post.locale,
                    `${channel("wire").path}${post.slug}/`,
                  )}
                  hreflang={foreign ? post.locale : undefined}
                >
                  {post.title}
                </a>
                {foreign && (
                  <abbr class="language" title={LOCALE_NAMES[post.locale]}>
                    {format(locale, "wire.english")}
                  </abbr>
                )}
                <time datetime={post.date}>{wireDate(locale, post.date)}</time>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  )}
</Base>
