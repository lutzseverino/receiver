---
// The wire: every post, newest first, or NO TRAFFIC.
import { loadPosts, wirePosts } from "@/data/posts";
import { format } from "@/i18n/format";
import {
  DEFAULT_LOCALE,
  localePath,
  localeRoutes,
  type Locale,
} from "@/i18n/locales";
import Base from "@/layouts/Base.astro";

export function getStaticPaths() {
  return localeRoutes();
}

type Props = { locale: Locale };

const { locale } = Astro.props;
const siteLocale = locale === "en-XA" ? DEFAULT_LOCALE : locale;
const posts = wirePosts(await loadPosts(), siteLocale);
---

<Base
  locale={locale}
  title={format(locale, "copy.wire.title")}
  description={format(locale, "copy.wire.description")}
>
  <h1>{format(locale, "common.channel.wire")}</h1>
  {posts.length === 0 ? (
    <p class="empty">{format(locale, "wire.empty")}</p>
  ) : (
    <ul class="entries">
      {posts.map((post) => (
        <li lang={post.locale === siteLocale ? undefined : post.locale}>
          <a
            href={localePath(post.locale, `/blog/${post.slug}/`)}
            hreflang={post.locale === siteLocale ? undefined : post.locale}
          >
            {post.title}
          </a>
          <time datetime={post.date}>{post.date}</time>
        </li>
      ))}
    </ul>
  )}
</Base>
