---
// Projects: every project in the allowlist's order, with its tagline,
// facts and links, or the empty band. Each entry carries its README lead's
// first paragraph as text in `data-lead`, and the list the display's OPEN
// label in `data-open`, for the display's preview card
// (`src/receiver/channels/projects.ts`).
import ProjectFacts from "@/components/projects/ProjectFacts.astro";
import ProjectLinks from "@/components/projects/ProjectLinks.astro";
import { loadProjects } from "@/data/projects";
import { markdownText } from "@/data/readme";
import { format } from "@/i18n/format";
import { localePath, localeRoutes, type Locale } from "@/i18n/locales";
import Base from "@/layouts/Base.astro";
import { channel } from "@/lib/channels";

export function getStaticPaths() {
  return localeRoutes();
}

type Props = { locale: Locale };

const { locale } = Astro.props;
const projects = await loadProjects();
---

<Base
  locale={locale}
  title={format(locale, "copy.projects.title")}
  description={format(locale, "copy.projects.description")}
>
  <h1>{format(locale, "common.channel.projects")}</h1>
  {projects.length === 0 ? (
    <p class="empty">{format(locale, "projects.empty")}</p>
  ) : (
    <ul class="entries" data-open={format(locale, "projects.open")}>
      {projects.map((project) => (
        <li
          data-lead={
            project.lead[0] === undefined
              ? undefined
              : markdownText(project.lead[0])
          }
        >
          <a
            href={localePath(
              locale,
              `${channel("projects").path}${project.id}/`,
            )}
          >
            {project.name}
          </a>
          {project.featured && (
            <span class="on-air">{format(locale, "projects.on-air")}</span>
          )}
          <p class="tagline" lang="en">
            {project.tagline}
          </p>
          <ProjectFacts locale={locale} project={project} />
          <ProjectLinks locale={locale} project={project} />
        </li>
      ))}
    </ul>
  )}
</Base>
