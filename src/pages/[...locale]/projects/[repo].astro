---
// A project's own page: its name, tagline, facts, site and source links, and
// README lead. The README's text stays in English on every locale's page;
// the labels around it are translated.
import { loadProjects, type Project } from "@/data/projects";
import { format } from "@/i18n/format";
import { localeRoutes, type Locale } from "@/i18n/locales";
import Base from "@/layouts/Base.astro";
import { renderMarkdown } from "@/lib/markdown";

export async function getStaticPaths() {
  const projects = await loadProjects();
  return localeRoutes().flatMap(({ params, props }) =>
    projects.map((project) => ({
      params: { ...params, repo: project.id },
      props: { ...props, project },
    })),
  );
}

type Props = { locale: Locale; project: Project };

const { locale, project } = Astro.props;
const lead = await Promise.all(project.lead.map(renderMarkdown));
---

<Base
  project={project}
  locale={locale}
  title={format(locale, "copy.project.title", { name: project.name })}
  description={format(locale, "copy.project.description", {
    name: project.name,
    tagline: project.tagline,
  })}
>
  <h1>{project.name}</h1>
  {project.featured && (
    <p class="on-air">{format(locale, "projects.on-air")}</p>
  )}
  <p class="tagline" lang="en">
    {project.tagline}
  </p>
  <dl class="facts">
    {project.stack.length > 0 && (
      <div>
        <dt>{format(locale, "projects.stack")}</dt>
        <dd lang="en">{project.stack.join(" · ")}</dd>
      </div>
    )}
    <div>
      <dt>{format(locale, "projects.since")}</dt>
      <dd>{project.since}</dd>
    </div>
    <div>
      <dt>{format(locale, "projects.release")}</dt>
      <dd>
        {project.release ? (
          <>
            {project.release.tag} ·{" "}
            <time datetime={project.release.date}>{project.release.date}</time>
          </>
        ) : (
          format(locale, "projects.release.none")
        )}
      </dd>
    </div>
    <div>
      <dt>{format(locale, "projects.updated")}</dt>
      <dd>
        <time datetime={project.updated}>{project.updated}</time>
      </dd>
    </div>
  </dl>
  <ul class="project-links">
    {project.site && (
      <li>
        <a href={project.site}>{format(locale, "projects.site")}</a>
      </li>
    )}
    <li>
      <a href={project.repo}>{format(locale, "projects.source")}</a>
    </li>
  </ul>
  {lead.length > 0 && (
    <div class="lead" lang="en">
      {lead.map((paragraph) => (
        <Fragment set:html={paragraph} />
      ))}
    </div>
  )}
</Base>
