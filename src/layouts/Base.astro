---
// The document for every page: the HTML layer the receiver draws (ADR 0001),
// readable on its own in the plain style. The head opens the page in the
// visitor's language before anything is drawn, and carries the page's title,
// description, canonical URL and its `hreflang` alternates, with `x-default`
// at the English page, as repo-standards.com's base layout does, and the
// language's wire feed. The body holds the channels' navigation, the page's
// `main`, its language links and the receiver's controls, which only the
// receiver's script shows: SOUND and PLAIN while the display runs, and the
// way back to it on the plain page.
import ChannelNav from "@/components/ChannelNav.astro";
import { Button } from "@/components/app/button";
import LanguageLinks from "@/components/LanguageLinks.astro";
import LocaleScript from "@/components/LocaleScript.astro";
import { ANALYTICS_TOKEN } from "@/config";
import { format } from "@/i18n/format";
import {
  DEFAULT_LOCALE,
  LOCALES,
  defaultPath,
  localePath,
  type Locale,
  type SiteLocale,
} from "@/i18n/locales";
import { format } from "@/i18n/format";
import { analyticsBeacon } from "@/lib/analytics";
import { feedPath } from "@/lib/feed";
import "@/styles/global.css";

type Props = {
  locale: Locale;
  title: string;
  description: string;
  /** The languages the page exists in, English first; all by default. */
  locales?: readonly SiteLocale[];
  /** Whether search engines should leave the page out, as for NO SIGNAL. */
  noindex?: boolean;
  /** Whether the head may send a visit on to the visitor's language. A
   * language the address chooses is saved either way. */
  redirect?: boolean;
  /** The page's path in the default locale, when its address doesn't say,
   * as for NO SIGNAL. */
  path?: string;
  /** Whether a channel broadcasts the page; NO SIGNAL's has none. */
  signal?: boolean;
};

const {
  locale,
  title,
  description,
  locales = LOCALES,
  noindex = false,
  redirect = true,
  // the page's path in the default locale, as in `/projects/`
  path = defaultPath(Astro.url.pathname),
  signal = true,
} = Astro.props;
const canonical = new URL(localePath(locale, path), Astro.site);
const beacon = analyticsBeacon(ANALYTICS_TOKEN);
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <LocaleScript locale={locale} redirect={redirect} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {locales.map((other) => (
      <link
        rel="alternate"
        hreflang={other}
        href={new URL(localePath(other, path), Astro.site)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(DEFAULT_LOCALE, path), Astro.site)}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={format(locale, "copy.wire.title")}
      href={feedPath(locale)}
    />
    <slot name="head" />
    {beacon && <script is:inline defer {...beacon} />}
  </head>
  <body>
    <header>
      <ChannelNav locale={locale} path={path} />
    </header>
    <main data-signal={signal ? undefined : "none"}>
      <slot />
    </main>
    <footer>
      <LanguageLinks locale={locale} path={path} locales={locales} />
      <div class="receiver-controls">
        <Button
          type="button"
          variant="outline"
          size="sm"
          data-control="sound"
          data-on={format(locale, "receiver.sound.on")}
          data-off={format(locale, "receiver.sound.off")}
          aria-pressed="false"
          hidden
        >
          {format(locale, "receiver.sound")}
        </Button>
        <Button
          type="button"
          variant="outline"
          size="sm"
          data-control="plain"
          hidden
        >
          {format(locale, "receiver.plain")}
        </Button>
        <Button
          type="button"
          variant="outline"
          size="sm"
          data-control="display"
          hidden
        >
          {format(locale, "receiver.display")}
        </Button>
      </div>
    </footer>
    <script>
      import "@/receiver/boot";
    </script>
  </body>
</html>
